    },
    "ok": {
      "description": "Успех",
      "light": "#17703f",
      "dark": "#6fd69a"
    },
    "class-bg": {
      "description": "Пара — фон",
      "light": "#e4ecff",
      "dark": "#1b2c5a"
    },
    "class-fg": {
      "description": "Пара — текст",
      "light": "#1a3a9c",
      "dark": "#bdd0ff"
    },
    "class-bar": {
      "description": "Пара — левая полоса",
