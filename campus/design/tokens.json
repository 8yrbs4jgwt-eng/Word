    "deadline-fg": {
      "description": "Дедлайн — текст",
      "light": "#7a4708",
      "dark": "#ffd69c"
    },
    "deadline-bar": {
      "description": "Дедлайн — левая полоса",
      "light": "#c46f0a",
      "dark": "#f0a548"
    },
    "note-bg": {
      "description": "Заметка — фон",
      "light": "#f0e9fd",
      "dark": "#2d2252"
    },
    "note-fg": {
      "description": "Заметка — текст",
      "light": "#58389a",
      "dark": "#dac8ff"
    },
    "note-bar": {
      "description": "Заметка — левая полоса",
      "light": "#8a62d6",
      "dark": "#a98aee"
    }
  },
  "typography": {
    "display": {
      "description": "Заголовки, числа дней, название",
      "stack": "Iowan Old Style, Palatino Linotype, Source Serif 4, Georgia, Times New Roman, serif",
      "suggestedFigmaFont": "Source Serif 4 (или Georgia)",
      "weights": [
        600,
        700
      ],
      "letterSpacing": "-0.01em"
    },
    "sans": {
      "description": "Интерфейс, текст",
      "stack": "Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif",
      "suggestedFigmaFont": "Inter",
      "weights": [
        400,
        500,
        600
      ]
    },
    "scale": {
      "h1 (приветствие)": "36px / 40px, display 600",
      "h2 (заголовок периода, панели)": "24px / 30px, display 600",
      "h3 (день в списке)": "20px / 26px, display 600",
      "body": "15–16px / 24px, sans 400",
      "small": "14px / 20px",
      "caption": "12px / 16px",
      "eyebrow (подписи капсом)": "11.5px, sans 600, letter-spacing 0.09em, UPPERCASE"
    }
  },
  "radius": {
    "input/button": "12px",
    "card/panel/dialog": "16px",
    "chip (pill)": "9999px",
    "event chip": "8px"
  },
  "spacing": {
    "page padding": "12px mobile / 20px tablet / 32px desktop",
    "card padding": "16–24px",
    "gap between cards": "16–20px",
    "min touch target": "40–44px"
  },
  "layout": {
    "max width": "1400px",
    "desktop": "контент + правая колонка 336px (21rem)",
    "breakpoints": {
      "mobile": "<768px (вид «Список»)",
      "desktop": "≥1024px (две колонки)"
    }
  },
  "calendar": {
    "week hour height": "56px",
    "event left bar": "3px",
    "kinds": [
      "class (пара) — синий",
      "deadline (дедлайн) — янтарный",
      "note (заметка) — фиолетовый"
    ]
  },
  "icons": {
    "library": "lucide (https://lucide.dev), stroke 2px, размер 16–20px",
    "appIcon": "квадрат 512×512, скругление 112px, фон #2350d8, буква «Л» (serif bold, белая)"
  }
}