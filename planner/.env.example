# Скопируйте этот файл в .env (необязательно). Все значения можно не задавать.
PORT=3000
# Адрес, на котором слушает сайт. 127.0.0.1 — только этот компьютер (безопасно по умолчанию).
HOST=127.0.0.1
# Ключ ИИ (Anthropic API). Можно также ввести в Настройках сайта.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# 1 — разрешить создать ещё одну учётную запись (по умолчанию регистрация открыта только для первой)
ALLOW_REGISTRATION=0
# 0 — выключить кнопку деморежима
ALLOW_DEMO=1
# Ключ шифрования секретов (64 hex-символа). Если пусто — создаётся файл data/secret.key
APP_SECRET_KEY=
# 1 — если сайт открыт по https (cookie получит флаг Secure)
COOKIE_SECURE=0
