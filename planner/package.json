{
  "name": "planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Личный помощник и планировщик",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
